@using System.ComponentModel.DataAnnotations
@using Vault.Domain
@using Vault.App.Services;

@inject ClipboardService Clipboard

<EditForm Model="Model" OnValidSubmit="HandleSave">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Name *</label>
            <InputText class="form-control" @bind-Value="Model.Name" />
            <ValidationMessage For="() => Model.Name" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Username</label>
            <InputText class="form-control" @bind-Value="Model.Username" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Password *</label>

            <div class="input-group">
                <InputText class="form-control"
                        type="@(ShowPassword ? "text" : "password")"
                        @bind-Value="Model.Password" />

                <button type="button" class="btn btn-outline-secondary"
                        @onclick="() => ShowPassword = !ShowPassword">
                    @(ShowPassword ? "Hide" : "Show")
                </button>
                <button type="button" class="btn btn-outline-secondary"
                        @onclick="CopyPasswordAsync"
                        disabled="@string.IsNullOrEmpty(Model.Password)">
                    Copy
                </button>
            </div>

            <ValidationMessage For="() => Model.Password" />
        </div>

        <div class="col-md-6">
            <label class="form-label">URL</label>
            <InputText class="form-control" @bind-Value="Model.Url" />
        </div>

        <div class="col-12">
            <label class="form-label">Notes</label>
            <textarea class="form-control" rows="4" @bind="Model.Notes"></textarea>
        </div>

        <div class="col-12">
            <label class="form-label">Tags</label>
            
            @* Tags seleccionados actualmente *@
            @if (SelectedTags.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var tag in SelectedTags)
                    {
                        <span class="badge bg-primary d-flex align-items-center gap-2" 
                              style="padding: 0.5rem 0.75rem; font-size: 0.9rem;">
                            @tag
                            <button type="button" class="btn-close btn-close-white" 
                                    style="font-size: 0.65rem; padding: 0; width: 14px; height: 14px;"
                                    @onclick="() => RemoveTag(tag)"
                                    aria-label="Remove tag"></button>
                        </span>
                    }
                </div>
            }
            
            @* Tags disponibles para seleccionar *@
            @if (AvailableTags.Count > 0)
            {
                var unselectedTags = AvailableTags.Where(t => !SelectedTags.Contains(t, StringComparer.OrdinalIgnoreCase)).ToList();
                if (unselectedTags.Count > 0)
                {
                    <div class="small text-muted mb-2">Available tags:</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var tag in unselectedTags)
                        {
                            <button type="button" 
                                    class="badge bg-secondary border-0" 
                                    style="cursor: pointer; padding: 0.5rem 0.75rem; font-size: 0.9rem;"
                                    @onclick="() => ToggleTag(tag)">+ @tag</button>
                        }
                    </div>
                }
            }
            
            @* Input para crear nuevo tag *@
            <div class="input-group">
                <input type="text" 
                       class="form-control form-control-sm" 
                       placeholder="Add new tag..."
                       @bind="NewTagInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyPress" />
                <button type="button" 
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="AddNewTag"
                        disabled="@string.IsNullOrWhiteSpace(NewTagInput)">Add</button>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label">Attachments</label>
            <div class="border rounded p-3 bg-light">
                @if (!string.IsNullOrWhiteSpace(AttachmentError))
                {
                    <div class="alert alert-danger py-2 mb-3" role="alert">@AttachmentError</div>
                }

                @if (Model.Attachments.Count == 0)
                {
                    <div class="text-muted small mb-3">No attachments. Add images or PDF documents.</div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <div class="d-flex align-items-center gap-2 bg-white border rounded p-2">
                                @if (attachment.IsImage)
                                {
                                    <img src="@ImageSource(attachment)" alt="" style="width: 44px; height: 44px; object-fit: cover;" class="rounded border" />
                                }
                                else
                                {
                                    <span class="badge bg-secondary">PDF</span>
                                }
                                <div class="flex-grow-1 text-truncate">
                                    <div class="small fw-semibold text-truncate">@attachment.FileName</div>
                                    <div class="small text-muted">@FormatSize(attachment.Content.Length)</div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ViewAttachment(attachment)">View</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ReplaceAttachmentAsync(attachment.Id)">Replace</button>
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveAttachment(attachment.Id)">Remove</button>
                            </div>
                        }
                    </div>
                }
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddAttachmentAsync" disabled="@(Model.Attachments.Count >= VaultAttachment.MaximumCountPerEntry)">Add attachment</button>
                <div class="form-text">JPEG, PNG, GIF, WebP, or PDF. Up to 5 attachments, 5 MB each.</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 justify-content-end mt-3">
        <button type="button" class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</EditForm>

@if (PreviewAttachment is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-label="Attachment preview">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-truncate">@PreviewAttachment.FileName</h5>
                    <button type="button" class="btn-close" @onclick="ClosePreview" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center bg-light">
                    @if (PreviewAttachment.IsImage)
                    {
                        <img src="@AttachmentSource(PreviewAttachment)" alt="@PreviewAttachment.FileName" class="img-fluid rounded" />
                    }
                    else
                    {
                        <object data="@AttachmentSource(PreviewAttachment)" type="application/pdf" width="100%" height="600">
                            <div class="alert alert-warning mb-0">This device cannot preview this PDF.</div>
                        </object>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePreview">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool ShowPassword = false;
    private string NewTagInput = "";
    private List<string> SelectedTags = new();
    private string? AttachmentError;
    private VaultAttachment? PreviewAttachment;
    
    [Parameter] public EntryEditorModel Model { get; set; } = new();
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public IReadOnlyList<string> AvailableTags { get; set; } = Array.Empty<string>();

    protected override void OnParametersSet()
    {
        ShowPassword = false;
        
        // Inicializar tags seleccionados desde el modelo
        SelectedTags = Model.TagsText
            .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => t.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task HandleSave()
    {
        // Sincronizar tags seleccionados al modelo antes de guardar
        Model.TagsText = string.Join(Environment.NewLine, SelectedTags);
        await OnSave.InvokeAsync();
    }
    private async Task CopyPasswordAsync()
    {
        await Clipboard.SetTextAsync(Model.Password ?? "");
    }
    
    private void ToggleTag(string tag)
    {
        if (SelectedTags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            SelectedTags.RemoveAll(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase));
        else
            SelectedTags.Add(tag);
    }
    
    private void AddNewTag()
    {
        var trimmed = NewTagInput.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        if (SelectedTags.Contains(trimmed, StringComparer.OrdinalIgnoreCase)) return;
        
        SelectedTags.Add(trimmed);
        NewTagInput = "";
    }
    
    private void RemoveTag(string tag)
    {
        SelectedTags.RemoveAll(t => t.Equals(tag, StringComparison.OrdinalIgnoreCase));
    }
    
    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddNewTag();
        }
    }

    private async Task AddAttachmentAsync()
    {
        if (Model.Attachments.Count >= VaultAttachment.MaximumCountPerEntry)
        {
            AttachmentError = "An entry can contain up to five attachments.";
            return;
        }

        var attachment = await PickAttachmentAsync();
        if (attachment is not null)
            Model.Attachments.Add(attachment);
    }

    private async Task ReplaceAttachmentAsync(Guid id)
    {
        var attachment = await PickAttachmentAsync();
        if (attachment is null) return;

        var index = Model.Attachments.FindIndex(existing => existing.Id == id);
        if (index >= 0) Model.Attachments[index] = attachment;
    }

    private void RemoveAttachment(Guid id)
    {
        Model.Attachments.RemoveAll(attachment => attachment.Id == id);
        AttachmentError = null;
    }

    private void ViewAttachment(VaultAttachment attachment) => PreviewAttachment = attachment;

    private void ClosePreview() => PreviewAttachment = null;

    private async Task<VaultAttachment?> PickAttachmentAsync()
    {
        AttachmentError = null;
        try
        {
            var file = await FilePicker.Default.PickAsync();
            if (file is null) return null;

            await using var stream = await file.OpenReadAsync();
            var content = await ReadAttachmentAsync(stream);
            var mediaType = DetectMediaType(content);
            if (mediaType is null)
            {
                AttachmentError = "Select a JPEG, PNG, GIF, WebP, or PDF file.";
                return null;
            }

            return VaultAttachment.CreateNew(file.FileName, mediaType, content);
        }
        catch (ArgumentException exception)
        {
            AttachmentError = exception.Message;
            return null;
        }
        catch (IOException)
        {
            AttachmentError = "The selected file could not be read.";
            return null;
        }
    }

    private static async Task<byte[]> ReadAttachmentAsync(Stream stream)
    {
        await using var buffer = new MemoryStream();
        var chunk = new byte[81920];
        var total = 0;
        int read;
        while ((read = await stream.ReadAsync(chunk)) > 0)
        {
            total += read;
            if (total > VaultAttachment.MaximumSizeBytes)
                throw new ArgumentException("Attachments must not exceed 5 MB.");
            await buffer.WriteAsync(chunk.AsMemory(0, read));
        }
        return buffer.ToArray();
    }

    private static string? DetectMediaType(ReadOnlySpan<byte> content)
    {
        if (content.Length >= 3 && content[..3].SequenceEqual(new byte[] { 0xFF, 0xD8, 0xFF })) return "image/jpeg";
        if (content.Length >= 8 && content[..8].SequenceEqual(new byte[] { 0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A })) return "image/png";
        if (content.Length >= 6 && (content[..6].SequenceEqual("GIF87a"u8) || content[..6].SequenceEqual("GIF89a"u8))) return "image/gif";
        if (content.Length >= 12 && content[..4].SequenceEqual("RIFF"u8) && content.Slice(8, 4).SequenceEqual("WEBP"u8)) return "image/webp";
        if (content.Length >= 5 && content[..5].SequenceEqual("%PDF-"u8)) return "application/pdf";
        return null;
    }

    private static string ImageSource(VaultAttachment attachment)
        => AttachmentSource(attachment);

    private static string AttachmentSource(VaultAttachment attachment)
        => $"data:{attachment.MediaType};base64,{Convert.ToBase64String(attachment.Content.Span)}";

    private static string FormatSize(int bytes) => $"{Math.Ceiling(bytes / 1024d)} KB";
}

